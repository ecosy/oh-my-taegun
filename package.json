{
  "name": "oh-my-taegun",
  "version": "0.1.0",
  "description": "Local-first autonomous development harness",
  "type": "module",
  "bin": {
    "omt": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "cli": "tsx src/cli/index.ts",
    "check:traceability": "tsx scripts/check-traceability.ts",
    "doctor": "npm run cli -- doctor",
    "inspect": "npm run cli -- inspect",
    "design": "npm run cli -- design",
    "run": "npm run cli -- run",
    "resume": "npm run cli -- resume",
    "report": "npm run cli -- report",
    "design:v2": "npm run cli -- design --profile docs/v2/spec.yaml",
    "run:v2": "npm run cli -- run --profile docs/v2/spec.yaml",
    "resume:v2": "npm run cli -- resume --profile docs/v2/spec.yaml",
    "report:v2": "npm run cli -- report --profile docs/v2/spec.yaml",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:recovery": "vitest run tests/recovery",
    "test:policy": "vitest run tests/policy",
    "test:docs": "vitest run tests/docs",
    "test:docs:v2": "vitest run tests/v2/docs",
    "test:unit:v2": "vitest run tests/v2/unit",
    "test:integration:v2": "vitest run tests/v2/integration",
    "test:recovery:v2": "vitest run tests/v2/recovery",
    "test:policy:v2": "vitest run tests/v2/policy",
    "test:e2e:v2": "vitest run tests/v2/e2e",
    "test:model-parity:v2": "vitest run tests/v2/model-parity",
    "smoke:chat-dogfood:real": "tsx scripts/smoke-chat-dogfood-real.ts",
    "smoke:chat-dogfood:pr": "tsx scripts/smoke-chat-dogfood-pr.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
